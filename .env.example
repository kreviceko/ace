# ACE Studio
APP_HOST=127.0.0.1
APP_PORT=8787

# Official ACE-Step 1.5 REST API (sibling install)
ACESTEP_API_URL=http://127.0.0.1:8001
ACESTEP_PATH=../ACE-Step-1.5

# Shown in Settings when ACE-Step .env is missing; sibling ACE-Step-1.5/.env wins
ACESTEP_CONFIG_PATH=acestep-v15-turbo
ACESTEP_LM_MODEL_PATH=acestep-5Hz-lm-0.6B
ACESTEP_INIT_LLM=false

# Optional: SpaceXAI lyric writing assist (rhymes, rewrites, hooks)
# XAI_API_KEY=
# XAI_BASE_URL=https://api.x.ai/v1
# XAI_MODEL=grok-4.7
